@@ -0,0 +1,19 @@
+import { ChibiRenderer } from './ChibiRenderer';
+import { Live2DRenderer } from './Live2DRenderer';
+import { ModelConfig } from './model-registry';
+
+/** Either body ViviPet can show: a Live2D model or the code-drawn chibi. */
+export type AnyPetRenderer = Live2DRenderer | ChibiRenderer;
+
+/** Models whose path starts with "procedural:" are drawn in code instead of loaded from Live2D files. */
+export function rendererKind(model: ModelConfig | undefined): 'chibi' | 'live2d' {
+  return model?.path.startsWith('procedural:') ? 'chibi' : 'live2d';
+}
+
+export function createPetRenderer(model: ModelConfig | undefined): AnyPetRenderer {
+  return rendererKind(model) === 'chibi' ? new ChibiRenderer() : new Live2DRenderer();
+}
+
+export function isRendererFor(renderer: AnyPetRenderer, model: ModelConfig | undefined): boolean {
+  return (renderer instanceof ChibiRenderer) === (rendererKind(model) === 'chibi');
+}
