+import React, { useEffect, useRef, useState } from 'react';
+
+/** Companion brain HTTP API (D:\AI\Companion, python main.py) */
+const COMPANION_URL = 'http://127.0.0.1:18800';
+
+interface ChatBoxProps {
+  open: boolean;
+  onClose: () => void;
+  onError: (message: string) => void;
+  /** Called when the user starts typing, so the pet can look attentive. */
+  onTyping?: () => void;
+}
+
+/** Small input box under the pet; replies arrive through the adapter as speech. */
+export const ChatBox: React.FC<ChatBoxProps> = ({ open, onClose, onError, onTyping }) => {
+  const [text, setText] = useState('');
+  const [busy, setBusy] = useState(false);
+  const inputRef = useRef<HTMLInputElement>(null);
+
+  useEffect(() => {
+    if (open) window.setTimeout(() => inputRef.current?.focus(), 50);
+  }, [open]);
+
+  const send = async () => {
+    const message = text.trim();
+    if (!message || busy) return;
+    setText('');
+    setBusy(true);
+    try {
+      const res = await fetch(`${COMPANION_URL}/chat`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ text: message }),
+      });
+      if (!res.ok) throw new Error(`HTTP ${res.status}`);
+    } catch {
+      onError("I can't reach my brain - is the Companion running?");
+    } finally {
+      setBusy(false);
+      inputRef.current?.focus();
+    }
+  };
+
+  const feedback = (kind: 'like' | 'dislike') => {
+    fetch(`${COMPANION_URL}/feedback`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ kind }),
+    }).catch(() => {});
+  };
+
+  if (!open) return null;
+
+  return (
+    <div className="pet-interactive" style={boxStyles}>
+      <input
+        ref={inputRef}
+        value={text}
+        disabled={busy}
+        placeholder={busy ? 'Thinking...' : 'Say something...'}
+        onChange={(e) => {
+          if (!text && e.target.value) onTyping?.();
+          setText(e.target.value);
+        }}
+        onKeyDown={(e) => {
+          if (e.key === 'Enter') void send();
+          if (e.key === 'Escape') onClose();
+        }}
+        style={inputStyles}
+      />
+      <button title="I liked that" onClick={() => feedback('like')} style={iconButtonStyles}>👍</button>
+      <button title="Less of that" onClick={() => feedback('dislike')} style={iconButtonStyles}>👎</button>
+      <button title="Close (Esc)" onClick={onClose} style={iconButtonStyles}>×</button>
+    </div>
+  );
+};
+
+const boxStyles: React.CSSProperties = {
+  position: 'absolute',
+  right: '24px',
+  bottom: '12px',
+  width: '320px',
+  display: 'flex',
+  gap: '4px',
+  alignItems: 'center',
+  padding: '6px',
+  background: 'rgba(255, 255, 255, 0.96)',
+  borderRadius: '14px',
+  boxShadow: '0 8px 24px rgba(0, 0, 0, 0.25)',
+  border: '1px solid rgba(0, 0, 0, 0.08)',
+  zIndex: 110,
+  pointerEvents: 'auto',
+  fontFamily: 'system-ui, sans-serif',
+};
+
+const inputStyles: React.CSSProperties = {
+  flex: 1,
+  border: 'none',
+  outline: 'none',
+  background: 'transparent',
+  fontSize: '14px',
+  padding: '6px 8px',
+  color: '#1a202c',
+};
+
+const iconButtonStyles: React.CSSProperties = {
+  border: 'none',
+  background: 'transparent',
+  cursor: 'pointer',
+  fontSize: '15px',
+  padding: '2px 4px',
+};
